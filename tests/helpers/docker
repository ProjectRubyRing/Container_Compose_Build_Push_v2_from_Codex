# build_and_verify.sh は次の形で呼ぶため、スクリプト本文の特徴で処理を振り分ける。
#   docker exec    <cid> /bin/sh -c '<script>' _ <引数...>   → script は $5
#   docker exec -i <cid> /bin/sh -c '<script>' _ <引数...>   → script は $6
# ここで拾わないスクリプト (既存の環境変数収集など) は case を素通りし、
