# ---- EFS マウント伝播のプローブ ---------------------------------------------
# 対象コンテナから「シンボリックリンクをたどって読む」動きを再現する。
# 状態ファイルが無ければ missing、あれば symlink 経由で読めたものとして返す。
#   FAKE_EFS_PROPAGATION_BLIND_CONTAINERS  … 常に見えない (マウント漏れの再現)
#   FAKE_EFS_PROPAGATION_BROKEN_CONTAINERS … リンク先を解決できない (絶対パスの再現)
#   FAKE_EFS_PROPAGATION_STALE_CONTAINERS  … 最初の行しか見えない (更新が届かない再現)
if [ "${1:-}" = "exec" ] && [ "${4:-}" = "-c" ] && [ "${6:-}" = "efs-propagation-probe" ]; then
  fake_probe_cid="${2:-}"
  fake_probe_target="${7:-}"
  fake_batch_state="$(fake_batch_mock_state)"
  case " ${FAKE_EFS_PROPAGATION_BLIND_CONTAINERS:-} " in
    *" $fake_probe_cid "*) printf 'type=missing\n'; exit 3 ;;
  esac
  if [ ! -f "$fake_batch_state" ]; then
    printf 'type=missing\n'
    exit 3
  fi
  printf 'type=symlink\n'
  printf 'target=%s\n' "$(printf '%s' "${fake_probe_target##*/}" | sed 's/-file\.link$/.d\/payload.txt/')"
  case " ${FAKE_EFS_PROPAGATION_BROKEN_CONTAINERS:-} " in
    *" $fake_probe_cid "*) printf 'resolved=broken\n'; exit 4 ;;
  esac
  printf 'resolved=ok\n'
  printf 'owner=6301:6302\n'
  printf 'mode=664\n'
  printf 'read=ok\n'
  case " ${FAKE_EFS_PROPAGATION_STALE_CONTAINERS:-} " in
    *" $fake_probe_cid "*)
      printf 'content:%s\n' "$(head -n 1 "$fake_batch_state")"
      exit 0
      ;;
  esac
  while IFS= read -r fake_probe_line; do
    printf 'content:%s\n' "$fake_probe_line"
  done < "$fake_batch_state"
  exit 0
fi

# 読み取り専用ファイルシステム分析: コンテナ内の起動スクリプトの読み出し。
# FAKE_CONTAINER_SCRIPTS へ "コンテナ内のパス|ホスト側のファイル" を 1 行ずつ
# 指定すると、そのファイルの中身をスクリプトの中身として返す。指定の無いパスは
# 「コンテナ内に無い」状態を再現する。
if [ "${1:-}" = "exec" ] && [ "${3:-}" = "/bin/sh" ] && [ "${4:-}" = "-c" ] \
    && [[ "${5:-}" == *"__BUILD_AND_VERIFY_RO_SCRIPT__"* ]]; then
  shift 6
  for fake_script_target in "$@"; do
    printf '__BUILD_AND_VERIFY_RO_SCRIPT__FILE %s\n' "$fake_script_target"
    fake_script_source=""
    if [ -n "${FAKE_CONTAINER_SCRIPTS:-}" ]; then
      while IFS='|' read -r fake_script_path fake_script_file; do
        [ -n "$fake_script_path" ] || continue
        if [ "$fake_script_path" = "$fake_script_target" ]; then
          fake_script_source="$fake_script_file"
          break
        fi
      done <<< "$FAKE_CONTAINER_SCRIPTS"
    fi
    if [ -n "$fake_script_source" ] && [ -f "$fake_script_source" ]; then
      head -n 2000 "$fake_script_source"
    else
      printf '__BUILD_AND_VERIFY_RO_SCRIPT__MISSING\n'
    fi
  done
  printf '__BUILD_AND_VERIFY_RO_SCRIPT__END\n'
  exit 0
fi

# 読み取り専用ファイルシステム分析のコンテナ内プローブ。
# 実際のスクリプトと同じ区切り (MOUNTS / JBOSS / DIRS / END) で、
#   - /proc/self/mounts 相当のマウント一覧
#   - JBOSS_HOME の解決結果
#   - 対象ディレクトリごとの 存在 / 書き込み可否 / ファイル数 / 起動後の更新数
# を返す。read_only の有無 (FAKE_READONLY_ROOTFS) と tmpfs の指定
# (FAKE_CONTAINER_TMPFS) に応じて、書き込み可否が変わる様子を再現する。
if [ "${1:-}" = "exec" ] && [ "${3:-}" = "/bin/sh" ] && [ "${4:-}" = "-c" ] \
    && [[ "${5:-}" == *"__BUILD_AND_VERIFY_RO_PROBE__"* ]]; then
  # distroless イメージにはシェルが無いため、プローブ自体が実行できない。
  if [ "${FAKE_ADOT_DISTROLESS:-false}" = "true" ] && [ "${2:-}" = "cid-adot-collector" ]; then
    printf 'OCI runtime exec failed: exec failed: unable to start container process: exec: "/bin/sh": stat /bin/sh: no such file or directory: unknown\n' >&2
    exit 126
  fi
  fake_probe_mark="__BUILD_AND_VERIFY_RO_PROBE__"
  fake_probe_jboss_home="${FAKE_PROBE_JBOSS_HOME:-/opt/jboss-eap}"
  fake_probe_tmpfs_targets=""
  if [ -n "${FAKE_CONTAINER_TMPFS:-}" ]; then
    while IFS='|' read -r fake_tmpfs_target _fake_tmpfs_options; do
      [ -n "$fake_tmpfs_target" ] || continue
      fake_probe_tmpfs_targets="${fake_probe_tmpfs_targets} ${fake_tmpfs_target}"
    done <<< "$FAKE_CONTAINER_TMPFS"
  fi
  # 書き込み可能なマウント (バインド / ボリューム) も、読み取り専用ルートの中で
  # 書ける場所として扱う。
  fake_probe_rw_mounts=""
  if [ -n "${FAKE_CONTAINER_MOUNTS:-}" ]; then
    while IFS='|' read -r _fake_mount_type _fake_mount_source fake_mount_target fake_mount_rw; do
      [ -n "$fake_mount_target" ] || continue
      [ "$fake_mount_rw" = "true" ] || continue
      fake_probe_rw_mounts="${fake_probe_rw_mounts} ${fake_mount_target}"
    done <<< "$FAKE_CONTAINER_MOUNTS"
  fi

  # コンテナ内に存在するディレクトリ。JBoss EAP を入れた AP コンテナを想定する。
  fake_probe_exists() {
    case "$1" in
      /tmp|/var/tmp|/run|/var/log|/var/cache|/opt/java/openjdk/lib/security) return 0 ;;
      "$fake_probe_jboss_home"/standalone/*) return 0 ;;
      *) return 1 ;;
    esac
  }

  # 読み取り専用ルートでは、tmpfs か書き込み可能なマウントを割り当てたパス
  # (とその配下) だけが書ける。
  fake_probe_writable() {
    [ "${FAKE_READONLY_ROOTFS:-false}" = "true" ] || return 0
    for fake_probe_target in $fake_probe_tmpfs_targets $fake_probe_rw_mounts; do
      case "$1" in
        "$fake_probe_target"|"$fake_probe_target"/*) return 0 ;;
      esac
    done
    return 1
  }

  fake_probe_directory() {
    if ! fake_probe_exists "$1"; then
      printf '%s|missing|-|0|0\n' "$1"
      return 0
    fi
    fake_probe_files=0
    fake_probe_recent=0
    case "$1" in
      /tmp) fake_probe_files=4; fake_probe_recent=3 ;;
      "$fake_probe_jboss_home"/standalone/log) fake_probe_files=2; fake_probe_recent=2 ;;
      "$fake_probe_jboss_home"/standalone/configuration) fake_probe_files=6 ;;
      "$fake_probe_jboss_home"/standalone/deployments) fake_probe_files=2 ;;
      "$fake_probe_jboss_home"/standalone/data) fake_probe_files=3 ;;
      /var/log) fake_probe_files=1 ;;
    esac
    if fake_probe_writable "$1"; then
      printf '%s|exists|rw|%s|%s\n' "$1" "$fake_probe_files" "$fake_probe_recent"
    else
      printf '%s|exists|ro|%s|0\n' "$1" "$fake_probe_files"
    fi
  }

  printf '%sMOUNTS\n' "$fake_probe_mark"
  if [ "${FAKE_READONLY_ROOTFS:-false}" = "true" ]; then
    printf 'overlay / overlay ro,relatime 0 0\n'
  else
    printf 'overlay / overlay rw,relatime 0 0\n'
  fi
  printf 'proc /proc proc rw,nosuid,nodev,noexec 0 0\n'
  for fake_probe_target in $fake_probe_tmpfs_targets; do
    printf 'tmpfs %s tmpfs rw,nosuid,nodev 0 0\n' "$fake_probe_target"
  done
  if [ -n "${FAKE_CONTAINER_MOUNTS:-}" ]; then
    while IFS='|' read -r _fake_mount_type _fake_mount_source fake_mount_target fake_mount_rw; do
      [ -n "$fake_mount_target" ] || continue
      if [ "$fake_mount_rw" = "true" ]; then
        printf '/dev/sda1 %s ext4 rw,relatime 0 0\n' "$fake_mount_target"
      else
        printf '/dev/sda1 %s ext4 ro,relatime 0 0\n' "$fake_mount_target"
      fi
    done <<< "$FAKE_CONTAINER_MOUNTS"
  fi
  printf '%sJBOSS\n' "$fake_probe_mark"
  if [ "$fake_probe_jboss_home" != "none" ]; then
    printf '%s\n' "$fake_probe_jboss_home"
  fi
  printf '%sDIRS\n' "$fake_probe_mark"
  # $5 がスクリプト、$6 が sh の $0、$7 以降が対象ディレクトリ。
  shift 6
  for fake_probe_arg in "$@"; do
    fake_probe_directory "$fake_probe_arg"
  done
  if [ "$fake_probe_jboss_home" != "none" ]; then
    for fake_probe_suffix in standalone/tmp standalone/log standalone/data \
        standalone/configuration standalone/deployments standalone/content; do
      fake_probe_directory "${fake_probe_jboss_home}/${fake_probe_suffix}"
    done
  fi
  printf '%sEND\n' "$fake_probe_mark"
  exit 0
fi

# distroless イメージの再現: シェルも wget も同梱されておらず、
# /healthcheck バイナリも持たないコンテナとして振る舞う。
if [ "${FAKE_ADOT_DISTROLESS:-false}" = "true" ] \
    && [ "${1:-}" = "exec" ] && [ "${2:-}" = "cid-adot-collector" ]; then
  case "${3:-}" in
    /bin/sh|/bin/bash|/bin/ash|/busybox/sh|/usr/bin/sh|/usr/bin/bash)
      printf 'OCI runtime exec failed: exec failed: unable to start container process: exec: "%s": stat %s: no such file or directory: unknown\n' \
        "${3:-}" "${3:-}" >&2
      exit 126
      ;;
    wget|/healthcheck)
      printf 'OCI runtime exec failed: exec failed: unable to start container process: exec: "%s": executable file not found in $PATH: unknown\n' \
        "${3:-}" >&2
      exit 127
      ;;
  esac
fi

# シェルを持たないイメージの再現 (取り込み検証用)。
# build_and_verify.sh は detect_container_shell でシェルを探すため、その探索
# (sh -c "exit 0") ごと失敗させないと「探索不可」の分岐に入らない。
if [ "${FAKE_COPY_ARTIFACT_PROBE_NOSHELL:-false}" = "true" ] && [ "${1:-}" = "exec" ] \
    && [ "${4:-}" = "-c" ]; then
  case "${5:-}" in
    "exit 0"|*copy-artifact-probe*)
      printf 'OCI runtime exec failed: exec failed: unable to start container process: exec: "%s": stat %s: no such file or directory: unknown\n' \
        "${3:-}" "${3:-}" >&2
      exit 126
      ;;
  esac
fi

# ---- 対話シェルの解決 (bash が無いコンテナの再現) ----------------------------
# build_and_verify.sh は bash 系 → POSIX sh 系の順に `<シェル> -c 'exit 0'` を試す。
# FAKE_NO_BASH_CONTAINERS に挙げたコンテナでは bash 系をすべて失敗させ、
# alpine / busybox のような「bash を持たないイメージ」を再現する。
# FAKE_NO_SHELL_CONTAINERS に挙げたコンテナは sh も失敗させ、distroless を再現する。
if [ "${1:-}" = "exec" ]; then
  fake_shell_probe_cid=""
  fake_shell_probe_bin=""
  if [ "${2:-}" = "-u" ] && [ "${6:-}" = "-c" ] && [ "${7:-}" = "exit 0" ]; then
    fake_shell_probe_cid="${4:-}"
    fake_shell_probe_bin="${5:-}"
  elif [ "${4:-}" = "-c" ] && [ "${5:-}" = "exit 0" ]; then
    fake_shell_probe_cid="${2:-}"
    fake_shell_probe_bin="${3:-}"
  fi
  if [ -n "$fake_shell_probe_bin" ]; then
    case " ${FAKE_NO_SHELL_CONTAINERS:-} " in
      *" $fake_shell_probe_cid "*)
        printf 'OCI runtime exec failed: exec failed: unable to start container process: exec: "%s": stat %s: no such file or directory: unknown\n' \
          "$fake_shell_probe_bin" "$fake_shell_probe_bin" >&2
        exit 126
        ;;
    esac
    case "$fake_shell_probe_bin" in
      /bin/bash)
        case " ${FAKE_NO_BASH_CONTAINERS:-} " in
          *" $fake_shell_probe_cid "*)
            printf 'OCI runtime exec failed: exec failed: unable to start container process: exec: "/bin/bash": stat /bin/bash: no such file or directory: unknown\n' >&2
            exit 126
            ;;
        esac
        exit 0
        ;;
      /usr/bin/bash|/usr/local/bin/bash) exit 126 ;;
      /bin/sh) exit 0 ;;
      /usr/bin/sh|/bin/ash|/busybox/sh|/bin/dash) exit 126 ;;
    esac
  fi
fi

# ---- JBoss マスターパスワードの伝搬検証 -------------------------------------
# build_and_verify.sh が投げる各プローブを、環境変数で挙動を切り替えながら再現する。
#   FAKE_JBOSS_SECRET_VALUE       : ビルド中の /run/secrets が返す値 (未設定なら $JBOSS_MASTER_PASSWORD)
#   FAKE_JBOSS_SECRET_MISSING     : true なら /run/secrets にファイルが無い状態を再現
#   FAKE_JBOSS_PROBE_BUILD_FAIL   : true ならプローブビルドを失敗させる
#   FAKE_JBOSS_HOME               : コンテナ内の JBoss インストール先 (空なら未検出)
#   FAKE_JBOSS_STANDALONE_XML     : standalone.xml として返すホスト側のファイル
#   FAKE_JBOSS_CS_PASSWORD        : CredentialStore を開けるパスワード (未設定なら $JBOSS_MASTER_PASSWORD)
#   FAKE_JBOSS_ELYTRON_TOOL_MISSING : true なら elytron-tool.sh が無い状態を再現
#   FAKE_JBOSS_CS_FILE_MISSING    : true なら CredentialStore ファイルが無い状態を再現
fake_jboss_home() { printf '%s' "${FAKE_JBOSS_HOME-/opt/jboss-eap}"; }

# 伝搬検証のプローブビルド (docker build --secret ... --output type=local,dest=DIR)。
# BuildKit へ渡した環境変数の値がそのままマウントされる様子を再現する。
if [ "${1:-}" = "build" ] && [[ " $* " == *" --output "* ]]; then
  fake_probe_dest=""
  fake_probe_next=""
  for arg in "$@"; do
    if [ "$fake_probe_next" = "output" ]; then
      case "$arg" in
        type=local,dest=*) fake_probe_dest="${arg#type=local,dest=}" ;;
      esac
      fake_probe_next=""
      continue
    fi
    [ "$arg" = "--output" ] && fake_probe_next="output"
  done
  if [ "${FAKE_JBOSS_PROBE_BUILD_FAIL:-false}" = "true" ]; then
    printf 'ERROR: failed to solve: failed to compute cache key\n' >&2
    exit 1
  fi
  [ -n "$fake_probe_dest" ] || fail "$@"
  mkdir -p "$fake_probe_dest"
  if [ "${FAKE_JBOSS_SECRET_MISSING:-false}" = "true" ]; then
    printf 'missing' > "$fake_probe_dest/encoding"
    : > "$fake_probe_dest/value"
  else
    printf 'base64' > "$fake_probe_dest/encoding"
    printf '%s' "${FAKE_JBOSS_SECRET_VALUE-${JBOSS_MASTER_PASSWORD:-}}" \
      | base64 | tr -d '\n' > "$fake_probe_dest/value"
  fi
  exit 0
fi

