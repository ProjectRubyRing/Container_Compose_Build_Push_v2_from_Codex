# ---- 偽装バッチサーバー (batch-mock) の CLI ---------------------------------
# コンテナ内 CLI の代わりに、テスト用の状態ファイル (FAKE_BATCH_MOCK_STATE) へ
# 「印」を書き出す。伝播プローブはこの状態ファイルを読んで内容を返すため、
# 「偽装バッチサーバーが書いたものが他コンテナから見える」流れを再現できる。
fake_batch_mock_state() {
  printf '%s' "${FAKE_BATCH_MOCK_STATE:-${TMPDIR:-/tmp}/fake-batch-mock-state}"
}

if [ "${1:-}" = "exec" ] && [ "${3:-}" = "/bin/sh" ] && [ "${4:-}" = "-c" ] \
    && [[ "${5:-}" == *"batch_cli="* ]]; then
  fake_batch_sub="${7:-}"
  fake_batch_token="${8:-}"
  fake_batch_marker="${9:-}"
  fake_batch_state="$(fake_batch_mock_state)"
  if [ "${FAKE_BATCH_MOCK_CLI_MISSING:-false}" = "true" ]; then
    printf '偽装バッチサーバーの CLI が見つかりません: /opt/batch-mock/efs-propagation.sh\n' >&2
    exit 2
  fi
  case "$fake_batch_sub" in
    mounts)
      printf '/mnt/logs\n'
      printf '/mnt/data\n'
      ;;
    ready) : ;;
    write)
      if [ "${FAKE_BATCH_MOCK_WRITE_FAIL:-false}" = "true" ]; then
        printf 'EFS へ書き込めません: /mnt/logs/batch-mock (uid=6301 gid=6302)\n' >&2
        exit 1
      fi
      printf '%s\n' "$fake_batch_marker" > "$fake_batch_state"
      for fake_batch_root in /mnt/logs /mnt/data; do
        printf 'path=%s/batch-mock/%s.d kind=dir owner=6301:6302 mode=2775\n' \
          "$fake_batch_root" "$fake_batch_token"
        printf 'path=%s/batch-mock/%s.d/payload.txt kind=file owner=6301:6302 mode=664\n' \
          "$fake_batch_root" "$fake_batch_token"
        printf 'path=%s/batch-mock/%s-file.link kind=symlink target=%s.d/payload.txt\n' \
          "$fake_batch_root" "$fake_batch_token" "$fake_batch_token"
        printf 'read=%s/batch-mock/%s-file.link\n' "$fake_batch_root" "$fake_batch_token"
      done
      ;;
    append)
      if [ "${FAKE_BATCH_MOCK_APPEND_FAIL:-false}" = "true" ]; then
        printf 'EFS 上のファイルを書き換えられません\n' >&2
        exit 1
      fi
      printf '%s\n' "$fake_batch_marker" >> "$fake_batch_state"
      printf 'appended: %s\n' "$fake_batch_marker"
      ;;
    cleanup)
      if [ "${FAKE_BATCH_MOCK_CLEANUP_FAIL:-false}" = "true" ]; then
        exit 1
      fi
      rm -f -- "$fake_batch_state"
      ;;
    *)
      fail "batch-mock cli $*"
      ;;
  esac
  exit 0
fi

# 偽装バッチサーバーの実行 uid:gid。
if [ "${1:-}" = "exec" ] && [ "${3:-}" = "/bin/sh" ] && [ "${4:-}" = "-c" ] \
    && [[ "${5:-}" == *'id -u'* ]]; then
  printf '%s' "${FAKE_BATCH_MOCK_UID_GID:-6301:6302}"
