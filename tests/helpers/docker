    *"otel-env-begin:"*)
      case "$*" in
        *"cid-adot-collector"*)
          fake_otel_env="${FAKE_OTEL_COLLECTOR_ENV:-ECS_CONTAINER_METADATA_URI_V4=http://ecs-metadata-mock:8080/v4/task
PATH=/usr/bin}"
