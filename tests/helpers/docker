#!/usr/bin/env bash

set -uo pipefail

if [ -n "${FAKE_DOCKER_CALLS:-}" ]; then
  printf '%s\n' "$*" >> "$FAKE_DOCKER_CALLS"
fi

# ビルド実行時点でのファイル内容を控える (--copy-file の上書き検証用)。
# FAKE_BUILD_SNAPSHOT_SRC / FAKE_BUILD_SNAPSHOT の両方を指定したときだけ動く。
if [ -n "${FAKE_BUILD_SNAPSHOT:-}" ] && [ -n "${FAKE_BUILD_SNAPSHOT_SRC:-}" ] \
    && [[ " $* " == *" build "* ]]; then
  cp "$FAKE_BUILD_SNAPSHOT_SRC" "$FAKE_BUILD_SNAPSHOT" 2>/dev/null \
    || printf '<missing>\n' > "$FAKE_BUILD_SNAPSHOT"
fi

fail() {
  printf 'fake docker: unsupported arguments: %s\n' "$*" >&2
  exit 64
}

is_cleaned() {
  [ -n "${FAKE_DOCKER_CLEANED:-}" ] && [ -f "$FAKE_DOCKER_CLEANED" ]
}

# compose stop (SIGTERM) 済みかどうか。停止後は終了処理のログが増える様子を再現する。
is_compose_stopped() {
  [ -n "${FAKE_COMPOSE_SHUTDOWN_MARKER:-}" ] && [ -f "$FAKE_COMPOSE_SHUTDOWN_MARKER" ]
}

if [ "${1:-}" = "compose" ]; then
  shift
  subcommand=""
  for arg in "$@"; do
    case "$arg" in
      version|build|up|logs|ps|down|stop|config|pull)
        subcommand="$arg"
        break
        ;;
    esac
  done

  # 呼び出し回数を数え、「N 回目までは失敗し、それ以降は成功する」を再現する。
  # コールド実行の 1 回目だけ失敗して再実行では成功する事象の検証に使う。
  fake_attempt_count() {
    local counter_file="$1" count
    count="$(cat "$counter_file" 2>/dev/null || printf '0')"
    case "$count" in
      ''|*[!0-9]*) count=0 ;;
    esac
    count=$(( count + 1 ))
    printf '%s\n' "$count" > "$counter_file"
    printf '%s\n' "$count"
  }

  case "$subcommand" in
    version)
      printf 'Docker Compose version v2.29.0\n'
      ;;
    config)
      if [[ " $* " != *" --services "* ]]; then
        fail "compose $*"
      fi
      # compose.yml の定義順。コンテナを持たないサービスも含む点が ps との違い。
      for fake_service in ${FAKE_COMPOSE_CONFIG_SERVICES:-${FAKE_COMPOSE_PS_SERVICES:-app}}; do
        printf '%s\n' "$fake_service"
      done
      ;;
    build)
      printf '[fake-build] BUILDKIT_PROGRESS=%s\n' "${BUILDKIT_PROGRESS:-unset}"
      if [ "${FAKE_DOCKER_BUILD_FAIL:-false}" = "true" ]; then
        printf 'fake compose build failed\n' >&2
        exit 42
      fi
      # exporting to image / exporting layers で出力が途切れる様子の再現。
      # BuildKit (--progress=plain) は "exporting layers" の 1 行を出したあと、
      # 完了するまで何も出力しない。FAKE_DOCKER_BUILD_EXPORT_STALL に秒数を
      # 指定すると、その無出力時間を作り出す (ビルド監視のテスト用)。
      if [ -n "${FAKE_DOCKER_BUILD_EXPORT_STALL:-}" ]; then
        printf '#12 exporting to image\n'
        printf '#12 exporting layers\n'
        sleep "$FAKE_DOCKER_BUILD_EXPORT_STALL"
        printf '#12 exporting layers %ss done\n' "$FAKE_DOCKER_BUILD_EXPORT_STALL"
        printf '#12 writing image sha256:fake-exported-image done\n'
        printf '#12 DONE %ss\n' "$FAKE_DOCKER_BUILD_EXPORT_STALL"
      fi
      # ビルドでローカルイメージが世代交代する様子の再現。
      # FAKE_DOCKER_IMAGE_ID_FILE を指定したときだけ、image inspect が返す ID を
      # ビルド後の値へ差し替える (未指定なら ID は変わらない = 従来どおり)。
      if [ -n "${FAKE_DOCKER_IMAGE_ID_FILE:-}" ]; then
        printf '%s\n' "${FAKE_DOCKER_IMAGE_ID_AFTER_BUILD:-sha256:image-after-build}" \
          > "$FAKE_DOCKER_IMAGE_ID_FILE"
      fi
      ;;
    pull)
      # 実装側は使えるオプションを --help で確認してから渡す。
      # FAKE_COMPOSE_PULL_NO_OPTIONS=true で、いずれも持たない古い版を再現する。
      if [[ " $* " == *" --help "* ]]; then
        printf 'Usage:  docker compose pull [OPTIONS] [SERVICE...]\n\nOptions:\n'
        if [ "${FAKE_COMPOSE_PULL_NO_OPTIONS:-false}" != "true" ]; then
          printf '      --ignore-buildable       Ignore images that can be built\n'
          printf '      --ignore-pull-failures   Pull what it can and ignores images with pull failures\n'
          printf '      --policy string          Apply pull policy ("missing"|"always")\n'
        fi
        printf '  -q, --quiet                  Pull without printing progress information\n'
        exit 0
      fi
      # FAKE_COMPOSE_PULL_FAIL_TIMES 回目までは失敗する (再試行の検証用)。
      # FAKE_COMPOSE_PULL_FAIL_MODE=fatal で、再試行しても直らない失敗を再現する。
      if [ -n "${FAKE_COMPOSE_PULL_FAIL_TIMES:-}" ] \
          && [ -n "${FAKE_COMPOSE_PULL_COUNTER:-}" ]; then
        pull_attempt="$(fake_attempt_count "$FAKE_COMPOSE_PULL_COUNTER")"
        if [ "$pull_attempt" -le "$FAKE_COMPOSE_PULL_FAIL_TIMES" ]; then
          if [ "${FAKE_COMPOSE_PULL_FAIL_MODE:-transient}" = "fatal" ]; then
            printf 'Error response from daemon: pull access denied for j1/base.local\n' >&2
          else
            printf 'failed to fetch oauth token: unexpected status from GET request: 429 Too Many Requests\n' >&2
            printf 'toomanyrequests: You have reached your pull rate limit.\n' >&2
          fi
          exit 1
        fi
      fi
      printf 'fake images pulled\n'
      ;;
    up)
      # 依存サービス (adot collector) の healthcheck 失敗で
      # compose up --wait が失敗する状況の再現。
      if [ "${FAKE_COMPOSE_UP_FAIL:-false}" = "true" ]; then
        printf 'dependency failed to start: container adot-collector is unhealthy\n' >&2
        exit 1
      fi
      # FAKE_COMPOSE_UP_FAIL_TIMES 回目までは失敗し、それ以降は成功する。
      # イメージ・キャッシュ削除直後の 1 回目だけ失敗する事象の再現に使う。
      # FAKE_COMPOSE_UP_FAIL_MODE: cold-start (既定) / transient / fatal
      if [ -n "${FAKE_COMPOSE_UP_FAIL_TIMES:-}" ] \
          && [ -n "${FAKE_COMPOSE_UP_COUNTER:-}" ]; then
        up_attempt="$(fake_attempt_count "$FAKE_COMPOSE_UP_COUNTER")"
        if [ "$up_attempt" -le "$FAKE_COMPOSE_UP_FAIL_TIMES" ]; then
          case "${FAKE_COMPOSE_UP_FAIL_MODE:-cold-start}" in
            transient)
              printf 'Error response from daemon: Get "https://registry-1.docker.io/v2/": net/http: TLS handshake timeout\n' >&2
              ;;
            fatal)
              printf 'Error response from daemon: driver failed programming external connectivity: port is already allocated\n' >&2
              ;;
            *)
              printf 'dependency failed to start: container mysql is unhealthy\n' >&2
              ;;
          esac
          exit 1
        fi
      fi
      printf 'fake app container started\n'
      ;;
    logs)
      # ビルド失敗などでコンテナが 1 つも作られていない状態の再現。
      if [ "${FAKE_COMPOSE_NO_CONTAINERS:-false}" = "true" ]; then
        exit 0
      fi
      if [ -z "${FAKE_COMPOSE_LOG_FILE:-}" ]; then
        printf 'FAKE_COMPOSE_LOG_FILE is not set\n' >&2
        exit 65
      fi
      last_arg="${!#}"
      if [ "$last_arg" = "db" ]; then
        for log_number in $(seq 1 52); do
          printf 'db-1  | DB%03d: companion service log\n' "$log_number"
        done
      elif [ "$last_arg" = "cache" ]; then
        printf 'cache-1  | CACHE001: cache ready\n'
        printf 'cache-1  | CACHE002: accepting connections\n'
      elif [ "$last_arg" = "cwagent" ]; then
        printf 'cwagent  | I! CloudWatch agent started\n'
        printf 'cwagent  | I! Log collection configured\n'
      elif [ "$last_arg" = "adot-collector" ] || [ "$last_arg" = "otel" ]; then
        printf 'adot-collector  | TracesExporter resource spans: 2, spans: 4\n'
        # SIGTERM 受信後は ECS と同じく graceful shutdown のログが追記される。
        if is_compose_stopped; then
          printf 'adot-collector  | info service@v0.102.0/service.go:255 Received signal from OS {"signal": "terminated"}\n'
          printf 'adot-collector  | info extensions/extensions.go:60 Stopping extensions...\n'
          printf 'adot-collector  | info service@v0.102.0/service.go:169 Shutdown complete.\n'
        fi
      else
        cat "$FAKE_COMPOSE_LOG_FILE"
      fi
      ;;
    ps)
      # ps はコンテナを持つサービスだけを返すため、コンテナ未作成時は何も返さない。
      if [ "${FAKE_COMPOSE_NO_CONTAINERS:-false}" = "true" ]; then
        :
      elif [[ " $* " == *" --services "* ]]; then
        for fake_service in ${FAKE_COMPOSE_PS_SERVICES:-app}; do
          printf '%s\n' "$fake_service"
        done
      else
        case "${!#}" in
          cwagent) printf 'cid-cwagent\n' ;;
          cloudwatch-logs-mock) printf 'cid-cloudwatch-logs-mock\n' ;;
          adot-collector|otel) printf 'cid-adot-collector\n' ;;
          jaeger) printf 'cid-jaeger\n' ;;
          mysql80) printf 'cid-mysql80\n' ;;
          aurora84) printf 'cid-mysql84\n' ;;
          nohealth) printf 'cid-nohealth\n' ;;
          tlsapp) printf 'cid-tlsapp\n' ;;
          *) printf 'cid-app\n' ;;
        esac
      fi
      ;;
    stop)
      if [ -n "${FAKE_COMPOSE_SHUTDOWN_MARKER:-}" ]; then
        : > "$FAKE_COMPOSE_SHUTDOWN_MARKER"
      fi
      printf 'fake app container stopped\n'
      ;;
    down)
      printf 'fake app container removed\n'
      ;;
    *)
      fail "compose $*"
      ;;
  esac
  exit 0
fi

if [ "${1:-}" = "context" ] && [ "${2:-}" = "show" ]; then
  printf 'default\n'
  exit 0
fi

if [ "${1:-}" = "context" ] && [ "${2:-}" = "inspect" ]; then
  printf 'unix:///var/run/docker.sock\n'
  exit 0
fi

if [ "${1:-}" = "port" ] && [ "${2:-}" = "cid-app" ] && [ "${3:-}" = "8080/tcp" ]; then
  printf '0.0.0.0:18080\n'
  exit 0
fi

if [ "${1:-}" = "port" ] && [ "${2:-}" = "cid-cloudwatch-logs-mock" ] && [ "${3:-}" = "8080/tcp" ]; then
  printf '0.0.0.0:18480\n'
  exit 0
fi

if [ "${1:-}" = "port" ] && [ "${2:-}" = "cid-jaeger" ] && [ "${3:-}" = "16686/tcp" ]; then
  printf '0.0.0.0:16686\n'
  exit 0
fi

# OTel Collector の health_check 拡張ポート (ホストからの代替確認に使う)。
if [ "${1:-}" = "port" ] && [ "${2:-}" = "cid-adot-collector" ] && [ "${3:-}" = "13133/tcp" ]; then
  printf '0.0.0.0:13133\n'
  exit 0
fi

if [ "${1:-}" = "system" ] && [ "${2:-}" = "df" ]; then
  if is_cleaned; then
    printf 'Images|0 B\n'
    printf 'Containers|0 B\n'
    printf 'Local Volumes|0 B\n'
    printf 'Build Cache|0 B\n'
  else
    # FAKE_DOCKER_DF_COUNTER を指定すると、呼び出しのたびにビルドキャッシュが
    # 400MB ずつ増える (検証を繰り返して容量が増えていく状況の再現)。
    df_build_cache=400
    if [ -n "${FAKE_DOCKER_DF_COUNTER:-}" ]; then
      df_call_count="$(cat "$FAKE_DOCKER_DF_COUNTER" 2>/dev/null || printf '0')"
      df_call_count=$(( df_call_count + 1 ))
      printf '%s\n' "$df_call_count" > "$FAKE_DOCKER_DF_COUNTER"
      df_build_cache=$(( 400 * df_call_count ))
    fi
    printf 'Images|2 GB\n'
    printf 'Containers|100 MB\n'
    printf 'Local Volumes|500 MB\n'
    printf 'Build Cache|%s MB\n' "$df_build_cache"
  fi
  exit 0
fi

if [ "${1:-}" = "system" ] && [ "${2:-}" = "prune" ]; then
  if [ -n "${FAKE_DOCKER_CLEANED:-}" ]; then
    : > "$FAKE_DOCKER_CLEANED"
  fi
  printf 'Total reclaimed space: 0B\n'
  exit 0
fi

if [ "${1:-}" = "info" ]; then
  # data root は既定では返さない (ホスト側 df の値が環境依存になるため)。
  # FAKE_DOCKER_DATA_ROOT を指定したときだけ、その値を返す。
  if [ -n "${FAKE_DOCKER_DATA_ROOT:-}" ] && [[ " $* " == *" {{.DockerRootDir}} "* ]]; then
    printf '%s\n' "$FAKE_DOCKER_DATA_ROOT"
    exit 0
  fi
  exit 65
fi

# ビルド停滞の診断が最初に確認する「Docker daemon が応答するか」の再現。
# FAKE_DOCKER_DAEMON_HANG=true なら応答しない daemon として扱う (終了コード 1)。
if [ "${1:-}" = "version" ]; then
  if [ "${FAKE_DOCKER_DAEMON_HANG:-false}" = "true" ]; then
    printf 'Cannot connect to the Docker daemon\n' >&2
    exit 1
  fi
  printf '%s\n' "${FAKE_DOCKER_SERVER_VERSION:-27.1.1}"
  exit 0
fi

if [ "${1:-}" = "container" ]; then
  case "${2:-}" in
    ls)
      if ! is_cleaned; then
        if [ "$*" = "container ls -q --filter status=paused" ]; then
          printf 'cid-paused\n'
        else
          case "${3:-}" in
            -q)  printf 'cid-running\ncid-paused\n' ;;
            -aq) printf 'cid-running\ncid-paused\ncid-stopped\n' ;;
            *) fail "$@" ;;
          esac
        fi
      fi
      ;;
    unpause)
      shift 2
      printf '%s\n' "$@"
      ;;
    stop)
      shift 2
      printf '%s\n' "$@"
      ;;
    prune)
      printf 'Total reclaimed space: 100MB\n'
      ;;
    *)
      fail "$@"
      ;;
  esac
  exit 0
fi

if [ "${1:-}" = "builder" ] && [ "${2:-}" = "prune" ]; then
  # 実装側は --keep-storage が使えるかを --help で確認してから渡す。
  # FAKE_DOCKER_NO_KEEP_STORAGE=true で、その指定を持たない buildx を再現する。
  if [[ " $* " == *" --help "* ]]; then
    printf 'Usage:  docker builder prune\n\nOptions:\n'
    printf '  -a, --all                  Include internal/frontend images\n'
    printf '      --filter filter        Provide filter values\n'
    printf '  -f, --force                Do not prompt for confirmation\n'
    if [ "${FAKE_DOCKER_NO_KEEP_STORAGE:-false}" = "true" ]; then
      printf '      --max-used-space bytes Maximum amount of disk space allowed to keep for cache\n'
    else
      printf '      --keep-storage bytes   Amount of disk space to keep for cache\n'
    fi
    exit 0
  fi
  if [ "${FAKE_DOCKER_BUILDER_PRUNE_FAIL:-false}" = "true" ]; then
    printf 'fake builder prune failed\n' >&2
    exit 1
  fi
  printf 'Total reclaimed space: 400MB\n'
  exit 0
fi

if [ "${1:-}" = "image" ] && [ "${2:-}" = "ls" ]; then
  if ! is_cleaned; then
    printf 'sha256:image-one\nsha256:image-two\n'
  fi
  exit 0
fi

if [ "${1:-}" = "image" ] && [ "${2:-}" = "prune" ]; then
  printf 'Total reclaimed space: 2GB\n'
  exit 0
fi

if [ "${1:-}" = "image" ] && [ "${2:-}" = "rm" ]; then
  if [ "${FAKE_DOCKER_IMAGE_RM_FAIL:-false}" = "true" ]; then
    printf 'Error response from daemon: conflict: unable to delete %s\n' "${3:-}" >&2
    exit 1
  fi
  printf 'Deleted: %s\n' "${3:-}"
  exit 0
fi

if [ "${1:-}" = "image" ] && [ "${2:-}" = "inspect" ]; then
  case "$*" in
    *".Config.Env"*)
      printf 'PATH=/usr/bin\n'
      ;;
    *"len .RepoTags"*)
      # 旧世代イメージに残っているタグの数。0 = dangling (削除対象)。
      printf '%s\n' "${FAKE_DOCKER_IMAGE_REPOTAGS:-0}"
      ;;
    *"--format {{.Id}} "*)
      # 世代交代の判定に使う ID 単体の取得。
      # verify_local_image の '{{.Id}}|{{.Created}}|{{.Size}}' と区別するため、
      # 書式が {{.Id}} だけ (直後が空白) の呼び出しに限定する。
      # FAKE_DOCKER_IMAGE_ID_FILE があればその内容 (compose build で書き換わる)、
      # 無ければ従来どおり固定値を返す (= 実行前後で変化しない)。
      if [ -n "${FAKE_DOCKER_IMAGE_ID_FILE:-}" ] && [ -f "$FAKE_DOCKER_IMAGE_ID_FILE" ]; then
        cat "$FAKE_DOCKER_IMAGE_ID_FILE"
      else
        printf '%s\n' "${FAKE_DOCKER_IMAGE_ID:-sha256:test-image}"
      fi
      ;;
    *)
      printf 'sha256:test-image|2026-07-18T00:00:00Z|12345\n'
      ;;
  esac
  exit 0
fi

if [ "${1:-}" = "volume" ] && [ "${2:-}" = "ls" ]; then
  if ! is_cleaned; then
    printf 'volume-one\nvolume-two\n'
  fi
  exit 0
fi

if [ "${1:-}" = "volume" ] && [ "${2:-}" = "prune" ]; then
  printf 'Total reclaimed space: 500MB\n'
  exit 0
fi

if [ "${1:-}" = "network" ] && [ "${2:-}" = "ls" ]; then
  if ! is_cleaned; then
    printf 'network-one\n'
  fi
  exit 0
fi

if [ "${1:-}" = "network" ] && [ "${2:-}" = "prune" ]; then
  printf 'Deleted Networks:\nnetwork-one\n'
  exit 0
fi

if [ "${1:-}" = "inspect" ]; then
  case "$*" in
    *".Config.Healthcheck.Test"*)
      case "$*" in
        *"cid-nohealth"*) ;;
        *"cid-adot-collector"*)
          if [ "${FAKE_ADOT_DISTROLESS:-false}" = "true" ]; then
            # distroless イメージでよく使われる CMD-SHELL 形式の healthcheck。
            printf 'CMD-SHELL\n'
            printf 'wget -q -O- http://127.0.0.1:13133/ || exit 1\n'
          else
            printf 'CMD\n/healthcheck\n'
          fi
          ;;
        *)
          printf 'CMD-SHELL\n'
          if [ "${FAKE_HEALTHCHECK_SECRET:-false}" = "true" ]; then
            printf 'curl -u admin:super-secret -fs http://127.0.0.1:8080/health >/dev/null || exit 1\n'
          else
            printf 'curl -fs http://127.0.0.1:8080/health >/dev/null || exit 1\n'
          fi
          ;;
      esac
      ;;
    *".Config.Healthcheck.Interval"*)
      printf 'interval=30s\n'
      printf 'timeout=5s\n'
      printf 'retries=3\n'
      printf 'start_period=2m0s\n'
      ;;
    *".State.Health.Status"*)
      if [ "${FAKE_HEALTHCHECK_STATE_FAIL:-false}" = "true" ]; then
        printf 'unhealthy|3\n'
      else
        printf 'healthy|0\n'
      fi
      ;;
    *".State.Health.Log"*)
      printf '開始: 2026-07-24T01:00:00.000000000Z\n'
      printf '終了: 2026-07-24T01:00:00.050000000Z\n'
      printf '終了コード: 0\n'
      printf '出力:\n'
      printf 'healthcheck request completed\n'
      printf '────────────────────\n'
      printf '開始: 2026-07-24T01:00:30.000000000Z\n'
      printf '終了: 2026-07-24T01:00:30.040000000Z\n'
      printf '終了コード: 0\n'
      printf '出力:\n'
      printf 'healthcheck request completed\n'
      printf '────────────────────\n'
      ;;
    *".State.Status"*)
      # サイドカーの異常終了をレポートへ残せるか確認できるよう、
      # adot collector だけ終了済みとして扱う。
      case "$*" in
        *"cid-adot-collector"*) printf 'exited|1\n' ;;
        *) printf 'running|0\n' ;;
      esac
      ;;
    *".State.Running"*)
      printf 'true\n'
      ;;
    *"com.docker.compose.service"*)
      printf 'app\n'
      ;;
    *"{{.Name}}"*)
      case "$*" in
        *"cid-cwagent"*) printf '/cwagent\n' ;;
        *"cid-cloudwatch-logs-mock"*) printf '/cloudwatch-logs-mock\n' ;;
        *"cid-adot-collector"*) printf '/adot-collector\n' ;;
        *"cid-jaeger"*) printf '/jaeger\n' ;;
        *"cid-mysql80"*) printf '/mysql-8.0.42\n' ;;
        *"cid-mysql84"*) printf '/aurora-mysql-8.4\n' ;;
        *"cid-nohealth"*) printf '/no-healthcheck\n' ;;
        *"cid-tlsapp"*) printf '/app-front\n' ;;
        *) printf '/test-app-1\n' ;;
      esac
      ;;
    *".NetworkSettings.Networks"*)
      printf '172.20.0.2\n'
      ;;
    *"{{.Image}}"*)
      printf 'fake-image\n'
      ;;
    *".Config.Env"*)
      printf 'PATH=/usr/bin\n'
      ;;
    # 読み取り専用ファイルシステム分析: 起動スクリプトを特定するための
    # ENTRYPOINT / CMD と、相対パスの基点になる作業ディレクトリ。
    *".Config.Entrypoint"*)
      if [ -n "${FAKE_CONTAINER_ENTRYPOINT:-}" ]; then
        printf '%s\n' "$FAKE_CONTAINER_ENTRYPOINT"
      fi
      if [ -n "${FAKE_CONTAINER_CMD:-}" ]; then
        printf '%s\n' "$FAKE_CONTAINER_CMD"
      fi
      ;;
    *".Config.WorkingDir"*)
      printf '%s\n' "${FAKE_CONTAINER_WORKDIR:-/opt/jboss-eap}"
      ;;
    # 読み取り専用ファイルシステム分析: ルートファイルシステムを読み取り専用に
    # したかどうか (compose.yml の read_only が反映された結果)。
    *".HostConfig.ReadonlyRootfs"*)
      printf '%s\n' "${FAKE_READONLY_ROOTFS:-false}"
      ;;
    # 実際に効いているマウント ("type|source|destination|rw" の行)。
    *"range .Mounts"*)
      if [ -n "${FAKE_CONTAINER_MOUNTS:-}" ]; then
        printf '%s\n' "$FAKE_CONTAINER_MOUNTS"
      fi
      ;;
    # tmpfs マウント ("target|options" の行)。
    *".HostConfig.Tmpfs"*)
      if [ -n "${FAKE_CONTAINER_TMPFS:-}" ]; then
        printf '%s\n' "$FAKE_CONTAINER_TMPFS"
      fi
      ;;
    *)
      fail "$@"
      ;;
  esac
  exit 0
fi

# 書き込み層の変更一覧 (読み取り専用ファイルシステム分析で「実際に書かれた場所」
# として使う)。read_only のコンテナでは何も返らない状態も再現できるようにする。
if [ "${1:-}" = "diff" ]; then
  if [ -n "${FAKE_DOCKER_DIFF:-}" ]; then
    printf '%s\n' "$FAKE_DOCKER_DIFF"
  fi
  exit 0
fi

# 読み取り専用ファイルシステム分析: コンテナ内の起動スクリプトの読み出し。
# FAKE_CONTAINER_SCRIPTS へ "コンテナ内のパス|ホスト側のファイル" を 1 行ずつ
# 指定すると、そのファイルの中身をスクリプトの中身として返す。指定の無いパスは
# 「コンテナ内に無い」状態を再現する。
if [ "${1:-}" = "exec" ] && [ "${3:-}" = "/bin/sh" ] && [ "${4:-}" = "-c" ] \
    && [[ "${5:-}" == *"__BUILD_AND_VERIFY_RO_SCRIPT__"* ]]; then
  shift 6
  for fake_script_target in "$@"; do
    printf '__BUILD_AND_VERIFY_RO_SCRIPT__FILE %s\n' "$fake_script_target"
    fake_script_source=""
    if [ -n "${FAKE_CONTAINER_SCRIPTS:-}" ]; then
      while IFS='|' read -r fake_script_path fake_script_file; do
        [ -n "$fake_script_path" ] || continue
        if [ "$fake_script_path" = "$fake_script_target" ]; then
          fake_script_source="$fake_script_file"
          break
        fi
      done <<< "$FAKE_CONTAINER_SCRIPTS"
    fi
    if [ -n "$fake_script_source" ] && [ -f "$fake_script_source" ]; then
      head -n 2000 "$fake_script_source"
    else
      printf '__BUILD_AND_VERIFY_RO_SCRIPT__MISSING\n'
    fi
  done
  printf '__BUILD_AND_VERIFY_RO_SCRIPT__END\n'
  exit 0
fi

# 読み取り専用ファイルシステム分析のコンテナ内プローブ。
# 実際のスクリプトと同じ区切り (MOUNTS / JBOSS / DIRS / END) で、
#   - /proc/self/mounts 相当のマウント一覧
#   - JBOSS_HOME の解決結果
#   - 対象ディレクトリごとの 存在 / 書き込み可否 / ファイル数 / 起動後の更新数
# を返す。read_only の有無 (FAKE_READONLY_ROOTFS) と tmpfs の指定
# (FAKE_CONTAINER_TMPFS) に応じて、書き込み可否が変わる様子を再現する。
if [ "${1:-}" = "exec" ] && [ "${3:-}" = "/bin/sh" ] && [ "${4:-}" = "-c" ] \
    && [[ "${5:-}" == *"__BUILD_AND_VERIFY_RO_PROBE__"* ]]; then
  # distroless イメージにはシェルが無いため、プローブ自体が実行できない。
  if [ "${FAKE_ADOT_DISTROLESS:-false}" = "true" ] && [ "${2:-}" = "cid-adot-collector" ]; then
    printf 'OCI runtime exec failed: exec failed: unable to start container process: exec: "/bin/sh": stat /bin/sh: no such file or directory: unknown\n' >&2
    exit 126
  fi
  fake_probe_mark="__BUILD_AND_VERIFY_RO_PROBE__"
  fake_probe_jboss_home="${FAKE_PROBE_JBOSS_HOME:-/opt/jboss-eap}"
  fake_probe_tmpfs_targets=""
  if [ -n "${FAKE_CONTAINER_TMPFS:-}" ]; then
    while IFS='|' read -r fake_tmpfs_target _fake_tmpfs_options; do
      [ -n "$fake_tmpfs_target" ] || continue
      fake_probe_tmpfs_targets="${fake_probe_tmpfs_targets} ${fake_tmpfs_target}"
    done <<< "$FAKE_CONTAINER_TMPFS"
  fi
  # 書き込み可能なマウント (バインド / ボリューム) も、読み取り専用ルートの中で
  # 書ける場所として扱う。
  fake_probe_rw_mounts=""
  if [ -n "${FAKE_CONTAINER_MOUNTS:-}" ]; then
    while IFS='|' read -r _fake_mount_type _fake_mount_source fake_mount_target fake_mount_rw; do
      [ -n "$fake_mount_target" ] || continue
      [ "$fake_mount_rw" = "true" ] || continue
      fake_probe_rw_mounts="${fake_probe_rw_mounts} ${fake_mount_target}"
    done <<< "$FAKE_CONTAINER_MOUNTS"
  fi

  # コンテナ内に存在するディレクトリ。JBoss EAP を入れた AP コンテナを想定する。
  fake_probe_exists() {
    case "$1" in
      /tmp|/var/tmp|/run|/var/log|/var/cache|/opt/java/openjdk/lib/security) return 0 ;;
      "$fake_probe_jboss_home"/standalone/*) return 0 ;;
      *) return 1 ;;
    esac
  }

  # 読み取り専用ルートでは、tmpfs か書き込み可能なマウントを割り当てたパス
  # (とその配下) だけが書ける。
  fake_probe_writable() {
    [ "${FAKE_READONLY_ROOTFS:-false}" = "true" ] || return 0
    for fake_probe_target in $fake_probe_tmpfs_targets $fake_probe_rw_mounts; do
      case "$1" in
        "$fake_probe_target"|"$fake_probe_target"/*) return 0 ;;
      esac
    done
    return 1
  }

  fake_probe_directory() {
    if ! fake_probe_exists "$1"; then
      printf '%s|missing|-|0|0\n' "$1"
      return 0
    fi
    fake_probe_files=0
    fake_probe_recent=0
    case "$1" in
      /tmp) fake_probe_files=4; fake_probe_recent=3 ;;
      "$fake_probe_jboss_home"/standalone/log) fake_probe_files=2; fake_probe_recent=2 ;;
      "$fake_probe_jboss_home"/standalone/configuration) fake_probe_files=6 ;;
      "$fake_probe_jboss_home"/standalone/deployments) fake_probe_files=2 ;;
      "$fake_probe_jboss_home"/standalone/data) fake_probe_files=3 ;;
      /var/log) fake_probe_files=1 ;;
    esac
    if fake_probe_writable "$1"; then
      printf '%s|exists|rw|%s|%s\n' "$1" "$fake_probe_files" "$fake_probe_recent"
    else
      printf '%s|exists|ro|%s|0\n' "$1" "$fake_probe_files"
    fi
  }

  printf '%sMOUNTS\n' "$fake_probe_mark"
  if [ "${FAKE_READONLY_ROOTFS:-false}" = "true" ]; then
    printf 'overlay / overlay ro,relatime 0 0\n'
  else
    printf 'overlay / overlay rw,relatime 0 0\n'
  fi
  printf 'proc /proc proc rw,nosuid,nodev,noexec 0 0\n'
  for fake_probe_target in $fake_probe_tmpfs_targets; do
    printf 'tmpfs %s tmpfs rw,nosuid,nodev 0 0\n' "$fake_probe_target"
  done
  if [ -n "${FAKE_CONTAINER_MOUNTS:-}" ]; then
    while IFS='|' read -r _fake_mount_type _fake_mount_source fake_mount_target fake_mount_rw; do
      [ -n "$fake_mount_target" ] || continue
      if [ "$fake_mount_rw" = "true" ]; then
        printf '/dev/sda1 %s ext4 rw,relatime 0 0\n' "$fake_mount_target"
      else
        printf '/dev/sda1 %s ext4 ro,relatime 0 0\n' "$fake_mount_target"
      fi
    done <<< "$FAKE_CONTAINER_MOUNTS"
  fi
  printf '%sJBOSS\n' "$fake_probe_mark"
  if [ "$fake_probe_jboss_home" != "none" ]; then
    printf '%s\n' "$fake_probe_jboss_home"
  fi
  printf '%sDIRS\n' "$fake_probe_mark"
  # $5 がスクリプト、$6 が sh の $0、$7 以降が対象ディレクトリ。
  shift 6
  for fake_probe_arg in "$@"; do
    fake_probe_directory "$fake_probe_arg"
  done
  if [ "$fake_probe_jboss_home" != "none" ]; then
    for fake_probe_suffix in standalone/tmp standalone/log standalone/data \
        standalone/configuration standalone/deployments standalone/content; do
      fake_probe_directory "${fake_probe_jboss_home}/${fake_probe_suffix}"
    done
  fi
  printf '%sEND\n' "$fake_probe_mark"
  exit 0
fi

# distroless イメージの再現: シェルも wget も同梱されておらず、
# /healthcheck バイナリも持たないコンテナとして振る舞う。
if [ "${FAKE_ADOT_DISTROLESS:-false}" = "true" ] \
    && [ "${1:-}" = "exec" ] && [ "${2:-}" = "cid-adot-collector" ]; then
  case "${3:-}" in
    /bin/sh|/bin/bash|/bin/ash|/busybox/sh|/usr/bin/sh|/usr/bin/bash)
      printf 'OCI runtime exec failed: exec failed: unable to start container process: exec: "%s": stat %s: no such file or directory: unknown\n' \
        "${3:-}" "${3:-}" >&2
      exit 126
      ;;
    wget|/healthcheck)
      printf 'OCI runtime exec failed: exec failed: unable to start container process: exec: "%s": executable file not found in $PATH: unknown\n' \
        "${3:-}" >&2
