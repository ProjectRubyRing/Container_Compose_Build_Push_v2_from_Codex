emit_fake_find_entry() {
  local entry="$1" entry_path relative entry_depth=0 pruned_path entry_target=""
  # シンボリックリンクの候補は "パス<TAB>リンク先" で持つ。
  entry_path="${entry%%$'\t'*}"
  [ "$entry_path" != "$entry" ] && entry_target="${entry#*$'\t'}"
  for pruned_path in "${fake_find_pruned_paths[@]}"; do
    if [ "$entry_path" = "$pruned_path" ]; then
      [ "$fake_find_type" = "d" ] || return 0
      break
    fi
    if [[ "$entry_path" == "$pruned_path/"* ]]; then
      return 0
    fi
  done
  if [ "$fake_find_root" = "/" ]; then
    relative="${entry_path#/}"
  elif [ "$entry_path" = "$fake_find_root" ]; then
    relative=""
  elif [[ "$entry_path" == "$fake_find_root/"* ]]; then
    relative="${entry_path#"$fake_find_root"/}"
  else
    return 0
  fi
  while [ -n "$relative" ]; do
    entry_depth=$((entry_depth + 1))
    case "$relative" in
      */*) relative="${relative#*/}" ;;
      *) relative="" ;;
    esac
  done
  if [ "$fake_find_max_depth" = "all" ] || [ "$entry_depth" -le "$fake_find_max_depth" ]; then
    # 実物の find と同じく、-printf '%p\037%l\0' を指定されたときだけリンク先を添える。
    if [ "$fake_find_type" = "l" ] && [ "$fake_find_printf" = "true" ]; then
      printf '%s\037%s\0' "$entry_path" "$entry_target"
    else
      printf '%s\0' "$entry_path"
    fi
  fi
}

