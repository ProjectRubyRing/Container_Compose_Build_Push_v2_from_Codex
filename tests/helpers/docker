    # ADOT Collector の設定チェック: ENTRYPOINT + CMD を 1 行 1 引数で返す。
    # 実装側は otel-argv: の目印付きで問い合わせるので、.Config.Entrypoint の
    # 分岐に吸い込まれないよう、必ずここで先に拾う。
    *"otel-argv:"*)
      if [ -n "${FAKE_OTEL_ARGV:-}" ]; then
        while IFS= read -r fake_otel_arg; do
          [ -n "$fake_otel_arg" ] || continue
          printf 'otel-argv:%s\n' "$fake_otel_arg"
