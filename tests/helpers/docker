    printf '1\037/usr/bin/otelcol\037--config=/etc/otel/config.yaml\037\n'
    exit 0
  fi
  # JBoss EAP を OpenTelemetry Java エージェント付きで起動した状態の再現。
  printf '1\037/opt/java/openjdk/bin/java'
  printf '\037-D[Standalone]'
  printf '\037-server'
  printf '\037-Xms512m'
  printf '\037-Xmx1024m'
