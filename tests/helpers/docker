# /proc/<pid>/cmdline の走査 (JVM パラメータ / OpenTelemetry 一覧の収集)。
# 実際のスクリプトと同じく "PID<US>arg0<US>arg1..." 形式で返す。
if [ "${1:-}" = "exec" ] && [ "${3:-}" = "/bin/sh" ] && [ "${4:-}" = "-c" ] \
    && [[ "${5:-}" == *"/proc/[0-9]"* ]]; then
  if [ "${FAKE_DOCKER_NO_JAVA_PROCESS:-false}" = "true" ]; then
