      [ -n "${FAKE_JBOSS_STANDALONE_XML:-}" ] || exit 1
      printf '%s/standalone/configuration/standalone.xml' "$(fake_jboss_home)"
      exit 0
      ;;
    *'base64 < "$1"'*)
      # standalone.xml の読み出し
      [ -n "${FAKE_JBOSS_STANDALONE_XML:-}" ] || exit 1
      [ -f "$FAKE_JBOSS_STANDALONE_XML" ] || exit 1
      base64 < "$FAKE_JBOSS_STANDALONE_XML" | tr -d '\n'
      exit 0
      ;;
    '[ -x "$1" ]')
      # elytron-tool.sh の存在確認
      [ "${FAKE_JBOSS_ELYTRON_TOOL_MISSING:-false}" = "true" ] && exit 1
      exit 0
      ;;
    '[ -f "$1" ]')
      # CredentialStore ファイルの存在確認
      [ "${FAKE_JBOSS_CS_FILE_MISSING:-false}" = "true" ] && exit 1
      exit 0
      ;;
    *'credential-store --location'*)
      # elytron-tool credential-store --aliases 相当。
      # 標準入力の base64 を復号し、想定パスワードと一致したときだけ成功させる。
      fake_cs_encoded="$(cat)"
      fake_cs_password="$(printf '%s' "$fake_cs_encoded" | base64 -d 2>/dev/null; printf 'x')"
      fake_cs_password="${fake_cs_password%x}"
      fake_cs_expected="${FAKE_JBOSS_CS_PASSWORD-${JBOSS_MASTER_PASSWORD:-}}"
      if [ "$fake_cs_password" = "$fake_cs_expected" ]; then
        printf 'Aliases: orders-db-pw, mail-pw\n'
        exit 0
      fi
      printf 'ELYTOOL00013: Credential store command failed: keystore password was incorrect\n'
      exit 1
      ;;
  esac
fi

