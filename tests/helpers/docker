    # EFS マウント伝播確認が使う形式 (識別キー / マウント先 / rw|ro)。
    # FAKE_EFS_MOUNT_ENTRIES は "コンテナ ID|識別キー|マウント先|rw または ro" の行。
    *"{{if .Name}}"*)
      if [ -n "${FAKE_EFS_MOUNT_ENTRIES:-}" ]; then
        fake_mount_cid=""
        for fake_mount_arg in "$@"; do
          case "$fake_mount_arg" in
            cid-*) fake_mount_cid="$fake_mount_arg" ;;
          esac
        done
        while IFS='|' read -r fake_m_cid fake_m_key fake_m_dest fake_m_rw; do
          [ -n "$fake_m_cid" ] || continue
          [ "$fake_m_cid" = "$fake_mount_cid" ] || continue
          printf '%s\t%s\t%s\n' "$fake_m_key" "$fake_m_dest" "$fake_m_rw"
        done <<< "$FAKE_EFS_MOUNT_ENTRIES"
      fi
