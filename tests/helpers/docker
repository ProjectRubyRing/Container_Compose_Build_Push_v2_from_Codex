OTEL_SERVICE_NAME=orders-app
PATH=/usr/bin}"
          ;;
      esac
      while IFS= read -r fake_otel_line; do
        [ -n "$fake_otel_line" ] || continue
        printf 'otel-env-begin:%s\n' "$fake_otel_line"
        printf 'otel-env-end:\n'
      done <<< "$fake_otel_env"
      ;;
    # ALB ヘルスチェック偽装サービスの状態行 (起動状態|自身の health|連続失敗|再起動回数|起動時刻)。
    # .State.Health.Status を含むため、後段の分岐より先に拾う必要がある。
    *".State.StartedAt"*)
      if [ "${FAKE_ALB_HEALTHCHECK_SERVICE_DOWN:-false}" = "true" ]; then
        printf 'restarting|unhealthy|4|3|2026-07-24T01:00:00.000000000Z\n'
      else
        printf 'running|healthy|0|0|2026-07-24T01:00:00.000000000Z\n'
      fi
      ;;
    *".Config.Healthcheck.Test"*)
      case "$*" in
        *"cid-nohealth"*) ;;
        *"cid-adot-collector"*)
          if [ "${FAKE_ADOT_DISTROLESS:-false}" = "true" ]; then
            # distroless イメージでよく使われる CMD-SHELL 形式の healthcheck。
            printf 'CMD-SHELL\n'
            printf 'wget -q -O- http://127.0.0.1:13133/ || exit 1\n'
          else
            printf 'CMD\n/healthcheck\n'
          fi
          ;;
        *)
          printf 'CMD-SHELL\n'
          if [ "${FAKE_HEALTHCHECK_SECRET:-false}" = "true" ]; then
            printf 'curl -u admin:super-secret -fs http://127.0.0.1:8080/health >/dev/null || exit 1\n'
          else
            printf 'curl -fs http://127.0.0.1:8080/health >/dev/null || exit 1\n'
          fi
          ;;
      esac
      ;;
    *".Config.Healthcheck.Interval"*)
      printf 'interval=30s\n'
      printf 'timeout=5s\n'
      printf 'retries=3\n'
      printf 'start_period=2m0s\n'
      ;;
    *".State.Health.Status"*)
      if [ "${FAKE_HEALTHCHECK_STATE_FAIL:-false}" = "true" ]; then
        printf 'unhealthy|3\n'
      else
        printf 'healthy|0\n'
      fi
      ;;
    *".State.Health.Log"*)
      printf '開始: 2026-07-24T01:00:00.000000000Z\n'
      printf '終了: 2026-07-24T01:00:00.050000000Z\n'
      printf '終了コード: 0\n'
      printf '出力:\n'
      printf 'healthcheck request completed\n'
      printf '────────────────────\n'
      printf '開始: 2026-07-24T01:00:30.000000000Z\n'
      printf '終了: 2026-07-24T01:00:30.040000000Z\n'
      printf '終了コード: 0\n'
      printf '出力:\n'
      printf 'healthcheck request completed\n'
      printf '────────────────────\n'
      ;;
    *".State.Status"*)
      # サイドカーの異常終了をレポートへ残せるか確認できるよう、
      # adot collector だけ終了済みとして扱う。
      case "$*" in
        *"cid-adot-collector"*) printf 'exited|1\n' ;;
        *) printf 'running|0\n' ;;
      esac
      ;;
    *".State.Running"*)
      printf 'true\n'
      ;;
    *"com.docker.compose.project"*)
      printf '%s\n' "${FAKE_COMPOSE_PROJECT_NAME:-testproj}"
      ;;
    *"com.docker.compose.service"*)
      # ディレクトリツリーの Excel 出力は frontend / backend のサービス名で対象を
      # 選ぶため、コンテナ ID から導ける偽装サービスはその名前を返す。
      case "$*" in
