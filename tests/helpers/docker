    # 読み取り専用ファイルシステム分析: 起動スクリプトを特定するための
    # ENTRYPOINT / CMD と、相対パスの基点になる作業ディレクトリ。
    *".Config.Entrypoint"*)
      if [ -n "${FAKE_CONTAINER_ENTRYPOINT:-}" ]; then
