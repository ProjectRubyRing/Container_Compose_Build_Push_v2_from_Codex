    *"{{.Name}}"*)
      case "$*" in
        *"cid-cwagent"*) printf '/cwagent\n' ;;
        *"cid-cloudwatch-logs-mock"*) printf '/cloudwatch-logs-mock\n' ;;
        *"cid-adot-collector"*) printf '/adot-collector\n' ;;
        *"cid-jaeger"*) printf '/jaeger\n' ;;
        *"cid-mysql80"*) printf '/mysql-8.0.42\n' ;;
        *"cid-mysql84"*) printf '/aurora-mysql-8.4\n' ;;
        *"cid-nohealth"*) printf '/no-healthcheck\n' ;;
        *"cid-tlsapp"*) printf '/app-front\n' ;;
        *"cid-eapapp"*) printf '/app-eap\n' ;;
        *"cid-alb-healthcheck"*) printf '/alb-healthcheck\n' ;;
        *"cid-batch-mock"*) printf '/batch-mock\n' ;;
        *"cid-efs-mock"*) printf '/efs-mock\n' ;;
        *"cid-frontend-web"*) printf '/test-frontend-web-1\n' ;;
        *"cid-backend-api"*) printf '/test-backend-api-1\n' ;;
        *) printf '/test-app-1\n' ;;
      esac
      ;;
    *".NetworkSettings.Networks"*)
      printf '172.20.0.2\n'
      ;;
    *"{{.Image}}"*)
      printf 'fake-image\n'
      ;;
    *".Config.Env"*)
